[Unit]
Description=claude-peers bell (tailnet :8812)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mcp-servers/claude-peers-mcp
EnvironmentFile=%h/.local/state/peers-bell/bell.env
ExecStart=%h/mcp-servers/claude-peers-mcp/scripts/bell-launch.sh
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
